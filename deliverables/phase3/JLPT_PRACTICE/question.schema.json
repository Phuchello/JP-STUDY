{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"Original JLPT practice question metadata (guide; engine performs runtime checks)",
 "type":"object",
 "required":["id","level","categoryCode","conceptId","learningObjective","difficultyEstimate","origin","stem","options","correctAnswer","explanationVi","distractorExplanations","errorCategory","prerequisites","references","estimatedSeconds","reviewRecommendation","stimulusId","validation","patternId"],
 "properties":{
  "id":{"type":"string","pattern":"^N4-[A-Z]+-[0-9]{3}$"},
  "level":{"enum":["N4","N3","N2"]},
  "categoryCode":{"enum":["VOC","PART","CONJ","GRAM","ORDER","INTERP","SHORT","MED","LISTEN","COMM"]},
  "difficultyEstimate":{"type":"integer","minimum":1,"maximum":5},
  "options":{"type":"array","minItems":2,"maxItems":4,"items":{"type":"object","required":["id","text"],"properties":{"id":{"enum":["A","B","C","D"]},"text":{"type":"string","minLength":1}}}},
  "correctAnswer":{"enum":["A","B","C","D"]},
  "distractorExplanations":{"type":"object"},
  "prerequisites":{"type":"array","minItems":1,"items":{"type":"string"}},
  "references":{"type":"array","minItems":1,"items":{"type":"object","required":["title","url"]}},
  "estimatedSeconds":{"type":"number","exclusiveMinimum":0},
  "patternId":{"type":["string","null"]},
  "validation":{"type":"object","required":["status"],"properties":{"status":{"enum":["draft","reviewed"]}}}
 },
 "allOf":[{"if":{"properties":{"categoryCode":{"const":"LISTEN"}}},"then":{"required":["audio","evidence"],"properties":{"audio":{"type":"object","required":["script","scriptValidated"]}}}}]
}
