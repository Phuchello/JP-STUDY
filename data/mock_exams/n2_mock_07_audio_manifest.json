    "audioVerificationStatus": "PLAYBACK_QA_PENDING",
    "audioSourceType": "NEURAL_TTS_MULTI_VOICE",
    "speakerVoices": [
      "ja-JP-NanamiNeural",
      "ja-JP-KeitaNeural"
    ],
    "spokenOptionTexts": [
      "私のような若手でよろしければ、ぜひ喜んで挑戦させてください。",
      "いいえ、広報誌は今年度で廃刊になることが決まりました。",
      "はい、リーダーの席はすでに他の課長に決まりましたよ。"
    ],
    "spokenOptionsTranscriptSha256": "6ede95e8526e681623240629e7d3567ca3f95b82d70b17700492ca03c89e63f2"
  },
