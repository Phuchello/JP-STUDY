    "audioVerificationStatus": "PLAYBACK_QA_PENDING",
    "audioSourceType": "NEURAL_TTS_MULTI_VOICE",
    "speakerVoices": [
      "ja-JP-NanamiNeural",
      "ja-JP-KeitaNeural"
    ],
    "spokenOptionTexts": [
      "資料室は駅の向かいです。",
      "はい、専門家は今朝帰りました。",
      "では、説明を短い言葉に直してみましょう。"
    ],
    "spokenOptionsTranscriptSha256": "435e3d58c25648fdfe9811d7ee3caed2922b1e972e78566d3264a7e57ee6e19c"
  },
  "N2_09_M4_L02": {
    "questionId": "N2_09_M4_L02",
    "audioUrl": "audio/n2_mock_09/N2_09_M4_L02.mp3",
    "audioDurationSec": 26.284,
    "audioSha256": "b4cee36c784b59721a8d495d0781edf596108ff009d5fe37927bbb8dd7819c1d",
    "audioSizeBytes": 158348,
    "audioVerificationStatus": "PLAYBACK_QA_PENDING",
    "audioSourceType": "NEURAL_TTS_MULTI_VOICE",
    "speakerVoices": [
      "ja-JP-NanamiNeural",
      "ja-JP-KeitaNeural"
    ],
    "spokenOptionTexts": [
      "入口で昨日の新聞を読みました。",
      "はい、会場は三年前にできました。",
      "それなら、案内表示を増やしてみませんか。"
    ],
    "spokenOptionsTranscriptSha256": "ce1ad8c566cd4955171612e3d21009d7fd399c015bfc8c26e0743b1dd1e00df6"
  },
  "N2_09_M4_L03": {
    "questionId": "N2_09_M4_L03",
    "audioUrl": "audio/n2_mock_09/N2_09_M4_L03.mp3",
    "audioDurationSec": 26.164,
    "audioSha256": "459f9ec14e67efc272f405e7d51f1da5c9ff36e05ae39efd96e41a7d9aebe509",
