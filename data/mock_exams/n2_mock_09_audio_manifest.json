    "speakerVoices": [
      "ja-JP-NanamiNeural",
      "ja-JP-KeitaNeural"
    ],
    "spokenOptionTexts": [
      "要点を残して、重複している部分を削りましょう。",
      "はい、短い道を通って帰りました。",
      "展示会は午後から始まります。"
    ],
    "spokenOptionsTranscriptSha256": "d5889b6cc0369e69030df5aaa5f0ab8ab83c8a09b771e93c11145cf2e333892d"
  },
  "N2_09_M4_L09": {
