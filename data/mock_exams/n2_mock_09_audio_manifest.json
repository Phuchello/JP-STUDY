    "speakerVoices": [
      "ja-JP-NanamiNeural",
      "ja-JP-KeitaNeural"
    ],
    "spokenOptionTexts": [
      "いいえ、会議は来月終わります。",
      "はい、理由と一緒に記録しておくとよいでしょう。",
      "記録係は二階の部屋です。"
    ],
    "spokenOptionsTranscriptSha256": "5c06fe09d4722bc604d5a64a464abaa5d9b9c997d519ffa6fd9d308527a210b7"
  },
  "N2_09_M4_L08": {
