    "speakerVoices": [
      "ja-JP-NanamiNeural",
      "ja-JP-KeitaNeural"
    ],
    "spokenOptionTexts": [
      "別の地域や期間の結果とも比べてみましょう。",
      "数字は壁の右に書いてあります。",
      "はい、効果は午後に届きます。"
    ],
    "spokenOptionsTranscriptSha256": "35ae6b1251f08f6335be5836dead8cb68f6ef5f5362a487907bca0ac4e371028"
  },
  "N2_09_M4_L06": {
