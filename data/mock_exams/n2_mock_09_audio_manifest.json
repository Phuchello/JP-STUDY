      "ja-JP-KeitaNeural"
    ],
    "spokenOptionTexts": [
      "新聞の内容を証言より常に優先する",
      "記憶を疑って調査をやめる",
      "証言だけを事実として記録する",
      "他の資料とも比べ、違いの背景を確かめる"
    ],
    "spokenOptionsTranscriptSha256": "bbdb45499647e74c33074f28ef6bdeed8281ca840b788e59536dbda61cb341c3"
  },
  "N2_09_M3_L03": {
