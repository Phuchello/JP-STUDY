    "audioVerificationStatus": "PLAYBACK_QA_PENDING",
    "audioSourceType": "NEURAL_TTS_MULTI_VOICE",
    "speakerVoices": [
      "ja-JP-NanamiNeural",
      "ja-JP-KeitaNeural"
    ],
    "spokenOptionTexts": [
      "予約表は先月作りました。",
      "では、到着する時刻が分かったら連絡してください。",
      "はい、時間はいつも同じです。"
    ],
    "spokenOptionsTranscriptSha256": "6f0e1abccdf380845e9cfd4facaa2077132d6e3fa84283794c8f5bb1f32f3ae4"
  },
  "N2_09_M4_L04": {
    "questionId": "N2_09_M4_L04",
    "audioUrl": "audio/n2_mock_09/N2_09_M4_L04.mp3",
    "audioDurationSec": 24.748,
    "audioSha256": "41cdf5e44ca62d929e445eb664f842a121544e0a01dc26877164cfb7e411f62b",
    "audioSizeBytes": 149132,
    "audioVerificationStatus": "PLAYBACK_QA_PENDING",
