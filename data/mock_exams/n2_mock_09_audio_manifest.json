    "speakerVoices": [
      "ja-JP-NanamiNeural",
      "ja-JP-KeitaNeural"
    ],
    "spokenOptionTexts": [
      "はい、知らせは先週食べました。",
      "では、以前申し込んだ人にも改めて知らせましょう。",
      "方法は駅前で練習しました。"
    ],
    "spokenOptionsTranscriptSha256": "64c6ab2cd77a1580b31a1bb0b816793ad376f30852408e22df8f526c6ac5c630"
