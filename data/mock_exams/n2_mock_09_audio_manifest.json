    "speakerVoices": [
      "ja-JP-NanamiNeural",
      "ja-JP-KeitaNeural"
    ],
    "spokenOptionTexts": [
      "珍しい単語の一覧を作ること",
      "若い人に昔の表現だけを使わせること",
      "方言を日常会話からなくすこと",
      "使われる場面や世代差も含めて記録すること"
    ],
    "spokenOptionsTranscriptSha256": "9fb5cde8106c6ba7431d4082e00d9aad3d150217eaad1e2833c58c468fc2ee57"
  },
  "N2_09_M3_L05": {
    "questionId": "N2_09_M3_L05",
    "audioUrl": "audio/n2_mock_09/N2_09_M3_L05.mp3",
    "audioDurationSec": 59.62,
