    "speakerVoices": [
      "ja-JP-NanamiNeural",
      "ja-JP-KeitaNeural"
    ],
    "spokenOptionTexts": [
      "はい、道は毎日同じです。",
      "分かりました。着いたら受付に声をかけてください。",
      "集合写真は来週撮ります。"
    ],
    "spokenOptionsTranscriptSha256": "8f32a6b9af537f097286ab3bcb23b9dcac9418142aa6114cffa3bba41323924f"
  },
  "N2_09_M4_L07": {
