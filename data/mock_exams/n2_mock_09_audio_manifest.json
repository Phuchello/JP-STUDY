      "ja-JP-KeitaNeural"
    ],
    "spokenOptionTexts": [
      "来場者数を毎年同じにすること",
      "売上の数字だけでなく費用や普段の営業への影響も見ること",
      "地域の人の期待を後から推測すること",
      "準備費用を記録しないこと"
    ],
    "spokenOptionsTranscriptSha256": "0d145f48be83b4adecb15ca86df9abbc389eba15f2c833c228380fefb5d41e11"
  },
  "N2_09_M3_L04": {
    "questionId": "N2_09_M3_L04",
    "audioUrl": "audio/n2_mock_09/N2_09_M3_L04.mp3",
    "audioDurationSec": 63.292,
    "audioSha256": "6fc77930ea23a10715229df5bc0b6854ecdcb2c641b8800ebd41fb95ec4164cd",
