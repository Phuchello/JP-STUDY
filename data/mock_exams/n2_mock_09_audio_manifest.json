    "speakerVoices": [
      "ja-JP-NanamiNeural",
      "ja-JP-KeitaNeural"
    ],
    "spokenOptionTexts": [
      "参加しやすい役割や時間を考えてみましょう。",
      "はい、参加賞は駅で買えます。",
      "若い木は裏庭に植えました。"
    ],
    "spokenOptionsTranscriptSha256": "cddc8a1ac385063f32315573e88d12a09b177c07897a2781dfaf08446f8c6448"
  },
  "N2_09_M4_L05": {
    "questionId": "N2_09_M4_L05",
    "audioUrl": "audio/n2_mock_09/N2_09_M4_L05.mp3",
    "audioDurationSec": 25.804,
    "audioSha256": "5b5a7da27df990114144d87086812365c73c63e0c14208d098c69bc7c610363b",
